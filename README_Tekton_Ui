**CONTINUOS INTEGRATION USING TEKTON**

Step 1 - Make "image-build-task.yaml" generic
Currently it is hardcoded for tutorial-service. Now , Let's change the Task so it accepts an APP_NAME parameter.

Add: params:
       - name: APP_NAME
         type: string

workingDir: $(workspaces.source.path)/tutorial-service -> workingDir: $(workspaces.source.path)/$(params.APP_NAME)

oc start-build tutorial-service-tekton \                            oc start-build $(params.APP_NAME)-tekton \
  --from-dir="$(workspaces.source.path)/tutorial-service" \  ->     --from-dir="$(workspaces.source.path)/$(params.APP_NAME)" \
  --follow                                                           --follow

oc get imagestream tutorial-service  -> oc get imagestream $(params.APP_NAME)
oc get istag tutorial-service:latest -> oc get istag $(params.APP_NAME):latest

For backend:
APP_NAME = tutorial-service

For UI:
APP_NAME = tutorial-ui

Step 2 — Apply the modified Task
oc apply -f tasks\image-build-task.yaml
Expected: task.tekton.dev/image-build-task configured

oc get task image-build-task -o yaml

